# AREA environment. Create your .env with `make env` (fills every change-me with
# a random value) or copy this file and replace them by hand. Never commit .env.
# Every PR that reads a new variable adds it here with a description.

# PostgreSQL
# Database user and name created on first start of the postgres volume.
POSTGRES_USER=area
POSTGRES_DB=area
# Secret. Changing it after the first start requires `docker compose down -v`.
POSTGRES_PASSWORD=change-me

# Redis
# Secret. Required by every client of the broker (api, scheduler, worker).
REDIS_PASSWORD=change-me

# Worker
# How many runs one worker container executes at the same time (a positive integer).
WORKER_CONCURRENCY=4

# Authentication
# Secret, at least 32 characters. Signs the JWT access tokens; changing it logs everyone out.
JWT_SECRET=change-me
# Lifetime of an access token (Go duration: 15m, 1h, 24h...).
JWT_TTL=1h

# E-mail
# Sender of confirmation e-mails (caught by Mailpit in development).
SMTP_FROM=AREA <no-reply@area.local>

# Host ports
# Ports published on your machine; the containers always listen on the same internal ports.
API_PORT=8080
WEB_PORT=8081
MAILPIT_UI_PORT=8025

# Web client
# API base URL as seen from the browser, baked into the web build.
# Use your machine's LAN IP to reach the stack from another device.
PUBLIC_API_URL=http://localhost:8080
# Web client URL as seen from the browser, used in the links of confirmation e-mails.
PUBLIC_WEB_URL=http://localhost:8081
# Browser origins allowed to call the API (CORS), comma-separated: the web client
# and the Vite dev server (`npm run dev`). Add your LAN address if you use one.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
